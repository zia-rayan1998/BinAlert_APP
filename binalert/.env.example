# ---------------------------------------------------------------------------
# BinAlert frontend — environment variables (copy to `.env` before first run)
#
#   Copy-Item .env.example .env
#
# NEVER commit `.env`. These values are injected into the browser bundle at
# build time by Vite, so only `VITE_`-prefixed keys are exposed to the client.
# ---------------------------------------------------------------------------

# Port the Vite dev server listens on.
VITE_PORT=5173

# Base URL of the Node/Express application API.
# In development leave this pointing at localhost — the Vite dev server proxies
# /api to it, so the browser only ever talks to http://localhost:5173.
VITE_API_URL=http://localhost:4000

# Base URL of the Python FastAPI inference service.
# Leave EMPTY to run the app in demo mode (deterministic on-device inference,
# clearly labelled "Demo inference" in the UI). Set it to enable live AI.
VITE_AI_API_URL=http://localhost:8000

# Application name shown in the browser tab and marketing footer.
VITE_APP_NAME=BinAlert

# Version string surfaced on the admin "AI Model Stats" page.
VITE_APP_VERSION=1.0.0
