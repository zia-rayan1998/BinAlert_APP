# BinAlert AI service — local development
# Copy to `.env` in this folder:   Copy-Item .env.example .env
# NEVER commit `.env`.

# Host/port the service binds to. The frontend calls this URL directly from the
# browser (VITE_AI_API_URL), so AI_CORS_ORIGINS below must include its origin.
AI_HOST=127.0.0.1
AI_PORT=8000

# Comma-separated list of origins allowed to call the service from a browser.
# The Node API calls it server-side and is not subject to CORS.
AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Log level: debug | info | warning | error
AI_LOG_LEVEL=info

# Inference mode.
#   heuristic = deterministic image-feature rules (default, no model weights)
#   model     = load a real exported model from MODEL_PATH
AI_MODEL_MODE=heuristic

# Only used when AI_MODEL_MODE=model.
# Path to an exported ONNX file (onnxruntime) or TorchScript archive (torch).
# Leave empty in local development unless you have trained weights.
AI_MODEL_PATH=

# Label file for the exported model, one class name per line. Optional.
AI_LABELS_PATH=

# Maximum accepted upload size in megabytes.
AI_MAX_UPLOAD_MB=10
