# ---------------------------------------------------------------------------
# BinAlert application API — environment variables
#
#   Copy-Item .env.example .env
#
# NEVER commit `.env`. Rotate any secret that has ever been committed.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call this API.
# In development the Vite dev server proxies /api, so the browser origin is
# the frontend URL below.
CORS_ORIGIN=http://localhost:5173

# --- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://binalert:binalert_dev_password@localhost:5432/binalert?schema=public

# --- Authentication --------------------------------------------------------
# Secret used to sign JWTs. MUST be a long random string in any real deployment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Set to true to deliver the JWT in an HTTP-only cookie (recommended for
# production). When false the token is returned in the JSON body and the
# client sends it as `Authorization: Bearer <token>`.
AUTH_COOKIE=true
COOKIE_NAME=binalert_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Bcrypt cost factor for password hashing.
BCRYPT_ROUNDS=12

# --- Password reset --------------------------------------------------------
PASSWORD_RESET_TTL_MINUTES=30
FRONTEND_URL=http://localhost:5173

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp

# --- AI service ------------------------------------------------------------
# Base URL of the Python FastAPI inference service. Leave empty to return a
# 503 from /api/ai/* instead of proxying.
AI_SERVICE_URL=http://localhost:8000
AI_REQUEST_TIMEOUT_MS=20000

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Seed accounts (development only) --------------------------------------
# Password used for every demo account created by `npm run db:seed`.
SEED_PASSWORD=demo1234
